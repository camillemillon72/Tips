PROC SQL;
CREATE TABLE &produit._&annee. AS
SELECT a.*,b.libelle_up as LIB_UP, b.REGROUP_UT AS RUP
FROM &produit._&annee. as a 
LEFT JOIN FORMAT.utup_vs8 as b 
ON a.UP=b.UP
;QUIT;


