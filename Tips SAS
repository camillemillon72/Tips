/*-------------------------------------------------------------------------------------------------
	Mettre en colonne des éléments d'une seule colonne séparés par un point-virgule
-------------------------------------------------------------------------------------------------*/

/*motifs des avenants*/
proc sql;
create table motif_unique as
select distinct mot_avt,count(*) as nb
from motifs_avts
group by 1;
quit;

/* Extraire les éléments séparés par des point virgules */
data elements;
    set motif_unique(keep=mot_avt);
    length element $32767;

    do i = 1 to countw(mot_avt, ';');
        element = strip(scan(mot_avt, i, ';'));
        if not missing(element) then output;
    end;

    keep element;
run;

/* Garder chaque élément une seule fois */
proc sort data=elements
          out=liste_motifs
          nodupkey;
    by element;
run;



