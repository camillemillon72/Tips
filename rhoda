import unicodedata
import pandas as pd

LIBELLES = {"TRES_BAS": 1, "BAS": 2, "MOYEN": 3, "HAUT": 4, "TRES_HAUT": 5}


def mise_en_forme_rhoda(df_init, insee, peril="Secheresse"):
    """Regroupe les résultats par département, type de logement et seuil de vigilance.

    insee : DataFrame avec au moins les colonnes DEP (str) et NCC.
    """
    df = df_init.copy()

    df["CODE_DEP"] = df["dep"].astype(str).str.replace(r"\.0$", "", regex=True).str.zfill(2)
    df["ALEA"] = peril.upper()
    df["TYPE_ENJEUX"] = "BAN"

    seuil = (
        df[f"Seuil_MRN_{peril}"]
        .str.replace("Fort", "Haut", regex=False)   # sécheresse : FORT au lieu de HAUT
        .str.replace(" ", "_", regex=False)
        .str.upper()
        .str.normalize("NFKD").str.encode("ascii", "ignore").str.decode("ascii")
    )
    inconnus = set(seuil.dropna()) - set(LIBELLES)
    if inconnus:
        raise ValueError(f"Seuils non reconnus : {inconnus}")
    df["SEUIL_VIGILANCE"] = pd.Categorical(seuil, categories=list(LIBELLES), ordered=True)

    # Jointure INSEE contrôlée
    insee = insee.assign(DEP=insee["DEP"].astype(str).str.zfill(2))
    df = df.merge(insee[["DEP", "NCC"]], left_on="CODE_DEP", right_on="DEP",
                  how="left", validate="m:1").rename(columns={"NCC": "NOM_DEP"})
    manquants = df.loc[df["NOM_DEP"].isna(), "CODE_DEP"].unique()
    if len(manquants):
        print(f"Attention, départements absents du référentiel INSEE : {manquants}")

    # Nombre total d'enjeux par département / type de logement
    df["NB_ENJEUX"] = df.groupby(["type_logement", "CODE_DEP"])["CODE_DEP"].transform("size")

    cles = ["type_logement", "CODE_DEP", "NOM_DEP", "TYPE_ENJEUX", "NB_ENJEUX", "ALEA"]
    resultat = (
        df.groupby(cles + ["SEUIL_VIGILANCE"], observed=False, dropna=False)
          .size()
          .reset_index(name="NOMBRE")
    )
    # observed=False crée aussi des combinaisons absurdes entre clés non catégorielles : on filtre
    resultat = resultat[resultat["NB_ENJEUX"].notna()]

    resultat["TAUX"] = resultat["NOMBRE"] / resultat["NB_ENJEUX"] * 100
    resultat["SEUIL_VIGILANCE_NUM"] = resultat["SEUIL_VIGILANCE"].map(LIBELLES).astype(float)
    resultat["NBPOND"] = resultat["NOMBRE"] * resultat["SEUIL_VIGILANCE_NUM"]
    resultat["SUMPOND"] = resultat.groupby(["CODE_DEP", "type_logement"])["NBPOND"].transform("sum")

    return resultat


# 2. Grille complète : chaque (type_logement, département) × les 5 seuils
infos_dep = df[["type_logement", "CODE_DEP", "NOM_DEP",
                "TYPE_ENJEUX", "NB_ENJEUX", "ALEA"]].drop_duplicates()
seuils = pd.DataFrame({"SEUIL_VIGILANCE": list(LIBELLES)})
grille = infos_dep.merge(seuils, how="cross")

# 3. On rattache les comptages ; les seuils absents prennent 0
